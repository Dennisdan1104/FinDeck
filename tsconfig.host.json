{
  // Host aggregate (one of the two check units; see tsconfig.json). packages/client
  // type-checks in tsconfig.client.json: the two sides merge cordis Context under
  // the same keys, one program cannot see both.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "scripts/**/*.ts",
    "website/**/*.ts",
    "website/.vitepress/**/*.ts"
  ],
  // packages/client compiles in the Client aggregate; the Host program must
  // not also hold that source, because both sides merge cordis Context under
  // the same keys.
  "exclude": [
    "packages/client/*/src/**",
    "packages/client/tsdown.client.ts"
  ],
