{
  "name": "@deepseek-ai/dsh-session-format-v3-to-v4",
  "description": "Released-V3 codec and streaming tool-role, producer-source, parent-catalog, and delivery migration into V4",
  "version": "0.1.3-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dennisdan1104/FinDeck.git",
    "directory": "packages/session/session-format-v3-to-v4"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 3,
      "to": 4,
      "export": ".",
      "migration": "sessionFormatV3ToV4",
      "sourceCodec": "releasedV3SessionFormatCodec",
      "targetCodec": "releasedV4SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV4Header",
      "targetRestorer": "restoreReleasedV4Artifact"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:^",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
